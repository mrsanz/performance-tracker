{
  "name": "performance-tracker",
  "version": "0.1.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test",
    "lint": "ts-standard",
    "lint:fix": "ts-standard --fix",
    "print:version": "bun run src/backend/scripts/print-version.ts",
    "dev": "bun run db:migrate && bun --hot src/backend/index.ts",
    "dev:server": "bun --hot src/backend/index.ts",
    "build:server": "bun build --target bun --outfile dist/server.js src/backend/index.ts",
    "db:migrate": "bun run src/backend/database/migrate.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:seed": "bun run src/backend/database/seed.ts",
    "db:reset": "rm -f ./data/performance-tracker.db && bun run db:migrate && bun run db:seed",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/env": "^5.0.3",
    "@tanstack/react-query": "^5.90.5",
    "drizzle-orm": "^0.44.6",
    "effect": "^3.18.4",
  "fastify": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-pkg": "^9.0.1",
    "dotenv": "^16.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^12.4.1",
    "drizzle-kit": "^0.31.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "ts-standard": "^12.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.20"
  }
}
